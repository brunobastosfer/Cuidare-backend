NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://cuidare:CHANGE_ME_DB_PASSWORD@localhost:5434/cuidare?schema=public
# Em produção, migrations devem usar um usuário distinto com permissões DDL.
# MIGRATION_DATABASE_URL=postgresql://migration_user:password@db:5432/cuidare
POSTGRES_USER=cuidare
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=cuidare
DB_PORT=5434
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ISSUER=cuidare-backend
JWT_AUDIENCE=cuidare-app
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
AUTH_REQUIRE_VERIFIED_EMAIL=true
AUTH_LOGIN_IDENTITY_MAX=10
AUTH_REQUEST_IDENTITY_MAX=3
AUTH_IP_MAX=20
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RESPONSE_MIN_MS=250
# Preencher SMTP somente quando houver provedor aprovado; nunca versionar credenciais.
EMAIL_TRANSPORT=disabled
# EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=configure-localmente
# SMTP_PASSWORD=configure-localmente
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SWAGGER_ENABLED=true
# Políticas desativadas por padrão; validar textos/finalidades antes de configurar.
CONSENT_POLICIES={}
# Definir consentBased=true somente para políticas juridicamente validadas como baseadas em consentimento.
# Nenhum prazo legal presumido; {} mantém as categorias sem prazo, exigindo revisão.
PRIVACY_RETENTION_DAYS={}
# MEDICATION é uma categoria adicional nullable em dias; definir somente após revisão.
# APPOINTMENT cobre consultas/recomendações; padrão null, sem expurgo automático.
# DOCUMENT cobre metadados/bytes retidos; padrão null, sem purge automático.
# VACCINATION cobre registros informados; padrão null, sem prazo presumido.
# EDUCATION cobre matrículas/relatórios; padrão null, sem purge automático.
PRIVACY_EXPORT_MAX_ITEMS=1000
PRIVACY_EXPORT_MAX_BYTES=2097152
VACCINATION_STATUS_MAX_ITEMS=1000

# Storage privado, nunca servido por static/public. Produção: diretório absoluto
# canônico exclusivo, volume persistente e ACL do usuário de serviço revisada.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=.private-documents
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_MAX_STORED_BYTES=104857600
DOCUMENT_MAX_STORED_FILES=500
DOCUMENT_IO_CONCURRENCY=2
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
# Fail-closed: disabled mantém uploads indisponíveis (503), sem bypass.
# Habilitar clamav somente com clamd INSTREAM privado e atualizado, nunca Internet.
DOCUMENT_SCANNER=disabled
DOCUMENT_SCAN_HOST=127.0.0.1
DOCUMENT_SCAN_PORT=3310
DOCUMENT_SCAN_TIMEOUT_MS=5000
